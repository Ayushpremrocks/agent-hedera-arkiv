{
  "name": "dani.ai",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p . && tsc -p packages/web",
    "test": "node --test --import tsx \"packages/*/src/**/*.test.ts\"",
    "setup:accounts": "tsx spikes/setup-accounts.ts",
    "spike:arkiv": "tsx spikes/a-arkiv.ts",
    "spike:x402": "tsx spikes/b-x402.ts",
    "spike:nft": "tsx spikes/c-nft-swap.ts",
    "provider": "pnpm -C packages/provider start",
    "agent": "pnpm -C packages/agent start",
    "fleet": "pnpm -C packages/agent fleet",
    "task": "pnpm -C packages/agent task",
    "web": "pnpm -C packages/web dev",
    "host": "pnpm -C packages/host start",
    "provider:join": "pnpm -C packages/provider join",
    "demo": "tsx spikes/demo.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.24.0"
}
